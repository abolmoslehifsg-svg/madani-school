# همه‌ی مقادیر اختیاری‌اند؛ بدون هیچ تنظیمی هم برنامه کار می‌کند.
MADANI_SCHOOL_NAME=مدرسه سمپاد شهید مدنی
# مسیر فایل دیتابیس (پیش‌فرض: instance/madani.db)
MADANI_DB_PATH=instance/madani.db
# auto | true | false  — پشت HTTPS بودن کوکی (auto = تشخیص خودکار)
MADANI_COOKIE_SECURE=auto
# اگر پشت nginx/Apache/Cloudflare هستید 1 بگذارید
MADANI_BEHIND_PROXY=0
# اگر مقدار بدهید، ساخت اولین حساب مدیر فقط با وارد کردن همین توکن ممکن است
# (پیشنهاد: قبل از اولین اجرا روی سرور عمومی حتماً تنظیم کنید)
MADANI_SETUP_TOKEN=
# حداکثر حجم هر درخواست (مگابایت)
MADANI_MAX_REQUEST_MB=32
